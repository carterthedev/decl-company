# Node / npm
node_modules/
npm-debug.log
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Gulp / Build output (the theme generates a "theme" folder)
theme/
dist/
.temp/
.tmp/

# OS & Editor junk
.DS_Store
Thumbs.db
desktop.ini

# IDEs / Editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Logs
logs
*.log

# Dependency directories (if you ever add them)
/vendor/
/bower_components/

# Local environment files
.env
.env.local

# Cache
.cache/
.gulp/

# Optional: if you don’t want to commit the huge source images (recommended for big catalogs)
# Comment or delete the next line if you DO want to version-control your product photos
source/images/products/
# OR if you only want to ignore very heavy folders but keep the structure:
# source/images/products/**/raw/
# source/images/products/**/originals/

# Keep only these (so Git still tracks the folder structure even if empty)
!source/images/products/**/.gitkeep